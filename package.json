{
  "name": "@odivonpro/beauty",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/write-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "check": "npm run test && npm run check:links && npm run build",
    "check:links": "node scripts/check-links.mjs",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist/odivon-pro-beauty/browser --project-name=odivonpro-beauty --branch=main"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fullcalendar/angular": "^7.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "fullcalendar": "^7.1.1",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.12",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  }
}
